# 실습용 기본값. 실제 서비스라면 비밀값은 .env(또는 AWS Secrets Manager)에만 두고 Git에 올리지 않는다.
# docker-compose.yml은 이 파일을 먼저 읽고, .env가 있으면 그 값으로 덮어쓴다.

# --- PostgreSQL (아키텍처의 RDS PostgreSQL 대체) ---
POSTGRES_USER=lab
POSTGRES_PASSWORD=labpass
POSTGRES_DB=scholarship
DATABASE_URL=postgresql://lab:labpass@postgres:5432/scholarship

# --- Redis (큐 서버) ---
REDIS_PASSWORD=labredis
REDIS_URL=redis://:labredis@redis:6379/0

# --- MinIO (아키텍처의 S3 대체) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=minio:9000
# 브라우저가 presigned URL로 직접 받을 때 쓰는 주소 (서명에 host가 포함되므로 별도)
S3_PUBLIC_ENDPOINT=localhost:9000
S3_BUCKET=scholarship
PRESIGN_EXPIRES_SEC=300

# --- 내부 서버 주소 (Docker Compose 서비스 이름으로 서로를 찾는다) ---
MCP_SERVER_URL=http://mcp:8100/mcp
MOCK_SITE_URL=http://mock-sites

# --- 큐 / 장애 복구 파라미터 ---
# pending 메시지가 이 시간(ms) 이상 아무도 손대지 않으면 XAUTOCLAIM 대상이 된다
CLAIM_MIN_IDLE_MS=15000
# 처리 중인 Worker가 자기 메시지의 idle 시간을 리셋하는 주기 (lease 갱신)
LEASE_RENEW_MS=5000
# 이 횟수를 넘게 전달된 메시지는 DLQ로 보낸다
MAX_DELIVERIES=3
# 0이면 자동 수집 끔 (버튼/API로만 수집)
CRAWL_INTERVAL_SEC=0
# AI Worker 1개가 동시에 처리하는 작업 수. 작게 시작해서 부하 테스트로 늘린다.
# 1로 바꾸면 한 번에 1개씩 처리 (로그가 섞이지 않아 흐름 관찰이 쉬움)
WORKER_CONCURRENCY=5
